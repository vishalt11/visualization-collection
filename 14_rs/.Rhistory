get_item_details <- function(item_id) {
url <- paste0("https://secure.runescape.com/m=itemdb_rs/api/catalogue/detail.json?item=", item_id)
response <- GET(url)
if (status_code(response) != 200) return(NULL)
content <- fromJSON(content(response, "text", encoding = "UTF-8"))
item_data <- content$item
# The fix: wrap anything that could be mixed (numbers/strings) in as.character()
details <- data.frame(
id = item_data$id,
description = item_data$description,
members = as.character(item_data$members),
current_trend = item_data$current$trend,
current_price = as.character(item_data$current$price),
today_trend = item_data$today$trend,
today_price = as.character(item_data$today$price),
day30_trend = item_data$day30$trend,
day30_change = as.character(item_data$day30$change),
day90_trend = item_data$day90$trend,
day90_change = as.character(item_data$day90$change),
day180_trend = item_data$day180$trend,
day180_change = as.character(item_data$day180$change),
stringsAsFactors = FALSE
)
Sys.sleep(0.5) # Slightly slower to avoid the "EOF" hang-up
return(details)
}
