labs_yrs <- tibble(time = c(-30000000, -23030000, -5330000, -2580000, 1)) %>%
mutate(
mk = format_numbers(time),
jesus = ifelse(time < 0, "BC", "AD"),
lab = glue::glue("{mk} {jesus}")
)
p1 <- p1 %>% arrange(extinction)
g2 <- ggplot(data = p1, aes(x = 1.6, y = extinction)) +
geom_segment(data = labs_yrs, aes(x = 1.6, xend = 1.8, y = time, yend = time), linewidth = 0.5, color = "grey30") +
geom_segment(x = 1.6, xend = 1.6, y = -30100000, yend = 100000, lineend = "round", linewidth = 2.5, color = "grey30") +
annotate(geom = "rect", xmin = 1.610, xmax = period_height, ymin = -30100000, ymax = -23030000, fill = "#f6d55c", colour = "transparent", alpha = 0.3) +
annotate(geom = "rect", xmin = 1.610, xmax = period_height, ymin = -23030000, ymax = -5330000, fill = "#f79d84", colour = "transparent", alpha = 0.3) +
annotate(geom = "rect", xmin = 1.610, xmax = period_height, ymin = -5330000, ymax = -2580000, fill = "#3caea3", colour = "transparent", alpha = 0.3) +
annotate(geom = "rect", xmin = 1.610, xmax = period_height, ymin = -2580000, ymax = -10000, fill = "#20639b", colour = "transparent", alpha = 0.3) +
annotate(geom = "rect", xmin = 1.610, xmax = period_height, ymin = -10000, ymax = 100000, fill = "grey50", colour = "transparent", alpha = 0.3) +
geom_text_repel(data = p1, aes(label = scientific, color = Additional.Info), segment.color = "grey60",
segment.size = 0.1, family = "Cinzel", fontface = "bold",
size = 3.8, xlim  = c(0, 1.1), hjust = 1, angle = 45, max.overlaps = 12) +
geom_point(color = "transparent", fill = "white", size = 5, shape = 21) +
geom_point(color = "grey30", fill = alpha("grey10", 0.1), size = 5, shape = 21) +
geom_text(data = labs_yrs, aes(x = 1.72, y = time, label = lab),
family = "Cinzel", hjust = 0, color = "grey30", vjust = -1, size = 6) +
scale_x_continuous(limits = c(0, 2.3)) +
scale_color_manual(values = c("grey50", "#E07B39", "#b22222", "#6d2a1b", "#D72638", "#D4A017"), guide = 'none') +
theme(plot.title = element_text(family = "Cinzel"),
plot.subtitle = element_text(family = "Cinzel"),
legend.position = "none") +
labs(x = NULL, y = NULL) +
coord_flip()
