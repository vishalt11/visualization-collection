data(countriesCoarse)
for (i in seq_along(countriesCoarse@polygons)) {
Pols <- countriesCoarse@polygons[[i]]
for (j in seq_along(Pols@Polygons)) {
coords <- Pols@Polygons[[j]]@coords  # lon/lat
# lon = x, lat = y
lon <- coords[, 1] * pi/180  # to radians
lat <- coords[, 2] * pi/180  # to radians
# convert to Cartesian (radius=1)
xyz <- sphereplot::sph2car(long = lon, lat = lat, radius = 1)
# draw
lines3d(xyz, col = "white", lwd = 2)
}
}
